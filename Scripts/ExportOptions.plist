<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight / App Store: automatic signing issues the Apple
	     Distribution certificate and profile on export (with
	     -allowProvisioningUpdates). Upload is a separate altool step. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>NGM7GX8DGB</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
